# =============================================================================
# MemeCoin Intelligence HQ - environment configuration
# =============================================================================
# HOW TO USE:
#   1. Copy this file to a new file named exactly:  .env
#   2. Fill in the real values.
#   3. NEVER commit .env to git. It is already listed in .gitignore.
#
# Anything marked REQUIRED must be set before the app will start.
# Anything marked OPTIONAL has a safe default shown after the "=".
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (REQUIRED) - Supabase PostgreSQL
# -----------------------------------------------------------------------------
# Supabase Dashboard -> your project -> Connect -> ORMs/psycopg -> "Connection
# string". Use the SESSION POOLER string (port 5432) or the direct connection.
# It looks like:
#   postgresql://postgres.abcdefghijkl:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Require encrypted connections to the database. Leave as "require".
DB_SSLMODE=require

# How many seconds to wait when opening a DB connection before giving up.
DB_CONNECT_TIMEOUT=10


# -----------------------------------------------------------------------------
# TELEGRAM (REQUIRED from Stage F onward)
# -----------------------------------------------------------------------------
# Create a bot: open Telegram, message @BotFather, send /newbot, follow prompts.
# BotFather replies with a token like 123456789:AAE...  <- that is the value.
TELEGRAM_BOT_TOKEN=

# The chat that receives research notifications.
# To find it: message your new bot once, then open in a browser:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and copy the value of "chat":{"id": ... }
TELEGRAM_CHAT_ID=

# Chat that receives system/health alerts (scanner down, API failures).
# Can be the same as TELEGRAM_CHAT_ID. OPTIONAL - falls back to TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_CHAT_ID=

# How many pending alerts to send per scanner pass. After an outage there may
# be a backlog; this stops it all arriving at once.
NOTIFY_BATCH_SIZE=5

# How much detail each alert carries.
#   compact - short, phone-friendly: what moved, the numbers, security flags
#   full    - every verified fact, every risk, every source link
ALERT_FORMAT=compact

# Check contract security on newly discovered tokens: honeypot, mint
# authority, LP lock and holder concentration, via the free GoPlus API.
# These are the checks that actually predict rug pulls - market data does not.
# Costs one extra API call per new token and needs no key.
SECURITY_CHECKS_ENABLED=true


# -----------------------------------------------------------------------------
# ANALYSIS MODE - decides whether this project costs you anything at all
# -----------------------------------------------------------------------------
#   template - FREE. Builds the research report from the market data already
#              collected. Deterministic, no API key, no network call, and
#              structurally incapable of inventing a fact. This is the default.
#   claude   - Adds natural-language explanation of what happened. Costs money
#              per event analysed and needs ANTHROPIC_API_KEY below.
#
# Everything else in this project is free, so this single setting is the
# difference between a $0/month system and a metered one.
ANALYSIS_MODE=template


# -----------------------------------------------------------------------------
# CLAUDE API - ONLY needed when ANALYSIS_MODE=claude. Leave blank otherwise.
# This is the only component of the whole system that costs money.
# -----------------------------------------------------------------------------
# Get a key at https://console.anthropic.com -> API Keys. Starts with sk-ant-
# Leave EMPTY while ANALYSIS_MODE=template. The system runs fine without it.
ANTHROPIC_API_KEY=

# Model used for full research reports.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Hard safety cap: the app refuses to send more analyses than this per day.
# This is your spend guardrail. Start low.
CLAUDE_MAX_ANALYSES_PER_DAY=40

# Max tokens Claude may return per research report.
CLAUDE_MAX_OUTPUT_TOKENS=1200


# -----------------------------------------------------------------------------
# MARKET DATA PROVIDERS (no API key needed on free public tiers)
# -----------------------------------------------------------------------------
# Requests per minute we allow ourselves. Kept BELOW each provider's published
# limit so a burst never gets us rate-limited or banned.
#
# DEX Screener publishes two different limits:
#   300/min for /latest/dex/*  (pairs, search - what the scanner uses)
#    60/min for token-profile and token-boost endpoints
# 240 leaves 20% headroom on the endpoints we actually call.
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RATE_LIMIT_PER_MIN=240

# GeckoTerminal's free public tier is roughly 30 calls/min. 25 leaves headroom.
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_RATE_LIMIT_PER_MIN=25

# Seconds to cache an identical provider response. Prevents hammering the API
# when both scanners want the same token at the same time.
PROVIDER_CACHE_TTL_SECONDS=20

# Network timeout and retry behaviour for all outbound HTTP calls.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3


# -----------------------------------------------------------------------------
# SCANNER BEHAVIOUR
# -----------------------------------------------------------------------------
# Which chains to scan. Comma-separated. Must match keys in the chain registry
# (src/mihq/chains.py). Remove any you do not want to scan.
ENABLED_CHAINS=solana,ethereum,base,bsc,avalanche

# How often each scanner loop runs, in seconds.
DISCOVERY_INTERVAL_SECONDS=300
WATCHLIST_INTERVAL_SECONDS=60

# Max tokens the watchlist scanner will check in a single pass. Protects you
# from rate limits as the watchlist grows.
WATCHLIST_BATCH_SIZE=40


# -----------------------------------------------------------------------------
# SNAPSHOT WRITE POLICY - this is what keeps you inside Supabase's free tier
# -----------------------------------------------------------------------------
# Writing a snapshot on every pass would produce ~144,000 rows/day at 100
# watchlist tokens and exhaust the free 500 MB in under four days.
#
# Instead a snapshot is written only when something actually MOVED by more than
# the thresholds below, plus a guaranteed "heartbeat" snapshot so the history
# never has gaps. In a quiet market this cuts writes by roughly 80-90%.
#
# Lower numbers = more detail, more storage. Higher = less of both.
SNAPSHOT_PRICE_CHANGE_PCT=2.0
SNAPSHOT_LIQUIDITY_CHANGE_PCT=5.0
SNAPSHOT_VOLUME_CHANGE_PCT=10.0

# Always write a snapshot if the last one for a token is older than this, even
# when nothing changed. Guarantees an unbroken history. 900 = 15 minutes.
SNAPSHOT_HEARTBEAT_SECONDS=900

# Whether to store the full provider payload in market_snapshots.raw.
# The raw JSON is the bulk of each row's size.
#   events_only - keep it only for snapshots that triggered an alert (default)
#   always      - keep every payload (most storage, best audit trail)
#   never       - never keep it (least storage, no audit trail)
SNAPSHOT_RAW_MODE=events_only


# -----------------------------------------------------------------------------
# EVENT DETECTION - what counts as worth alerting about
# -----------------------------------------------------------------------------
# NOISE FLOORS. A token with $200 of liquidity moving 400% is two people and a
# bot, not news. Nothing below these floors can generate an alert at all.
# Raise them if you get too many alerts; lower them to catch smaller tokens.
EVENT_MIN_LIQUIDITY_USD=5000
EVENT_MIN_VOLUME_USD=10000

# 24h volume must rise by at least this percent between two checks.
EVENT_VOLUME_SPIKE_PCT=150

# Liquidity falling by this percent raises a RISK alert. This is the closest
# thing here to a rug-pull warning, so it is deliberately sensitive.
EVENT_LIQUIDITY_DRAIN_PCT=30

# Price moves, in percent, between two checks.
EVENT_PRICE_SURGE_PCT=25
EVENT_PRICE_COLLAPSE_PCT=30

# 24h volume divided by pool liquidity. 10 means the pool traded 10x its own
# size in a day. Can indicate artificial volume - or real interest in a thin
# pool. Flagged for investigation, never reported as a conclusion.
EVENT_CHURN_RATIO=10


# -----------------------------------------------------------------------------
# DAILY SUMMARY
# -----------------------------------------------------------------------------
# IANA timezone name used for "what day is it" and summary send time.
TIMEZONE=America/New_York

# Local 24h time to send the daily research summary.
DAILY_SUMMARY_HOUR=8
DAILY_SUMMARY_MINUTE=0


# -----------------------------------------------------------------------------
# APP / LOGGING
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# "text" for human-readable local development, "json" for hosted deployments.
LOG_FORMAT=text

# dev | prod. Only affects log verbosity and labels in notifications.
APP_ENV=dev

# Safety switch. When true, the app does all its work but sends NO Telegram
# messages and makes NO Claude calls. Use this while testing.
DRY_RUN=false
